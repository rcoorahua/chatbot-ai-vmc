# Plantilla de variables de entorno para dev local. Copiar a `.env` y completar.
# `.env` NO se versiona (esta en .gitignore). En stage/prod estas variables las inyecta CDK con
# los MISMOS nombres (infra/stacks/subastin_stack.py → common_env) y los secretos viven en
# Secrets Manager — nunca aqui ni en el codigo.

# Entorno: dev (local). stage/prod los define CDK.
STAGE=
# Region AWS (la confirma el equipo AWS, PLAN.md §6.1). Ej: us-east-1
AWS_REGION=
# En dev cualquier valor dummy sirve: dynamodb-local y localstack no validan credenciales.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Endpoints locales de docker-compose. Vacios en AWS (boto3 resuelve solo).
# dev: http://localhost:8001
DYNAMODB_ENDPOINT_URL=
# dev: http://localhost:4566
SQS_ENDPOINT_URL=
# dev: http://localhost:4566
S3_ENDPOINT_URL=

# Recursos (nombres con prefijo subastin-<stage>-, ver infra/stacks/subastin_stack.py)
TABLE_CONVERSATIONS=
TABLE_MESSAGES=
TABLE_TICKETS=
TABLE_ADVISORS=
TABLE_AI_USAGE=
IMAGES_BUCKET=
# dev: http://localhost:4566/000000000000/<nombre-cola>
AI_JOBS_QUEUE_URL=
NOTIFICATIONS_QUEUE_URL=

# IA — SOLO en dev van aqui; en stage/prod: Secrets Manager (TD-002 define acceso a Haiku)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# RAG en Pinecone (RF-017/018/019). El indice usa embedding integrado
# (multilingual-e5-large): Pinecone embebe el texto, NO se usa Gemini para eso.
# Lo crea `python -m scripts.helpcenter_upload` si no existe.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=subastin-rag
PINECONE_NAMESPACE=helpcenter
# Fragmentos que recibe el redactor (mas de 5 encarece el prompt y mete ruido).
RAG_TOP_K=4
# Umbral de RF-018: por debajo se considera que no hay evidencia y el caso deriva.
# SIN CALIBRAR: `python -m scripts.helpcenter_upload --verify` imprime los scores reales.
RAG_MIN_SCORE=0.75

# Identidad del chat (D-001, core/auth.py). SOLO en dev van aqui; en stage/prod: Secrets Manager.
# Secreto compartido con VMC: su servidor firma el JWT de identidad del usuario con el.
# dev: cualquier texto; debe coincidir con el que usa widget/test.html para simular a VMC.
VMC_IDENTITY_SECRET=
# Clave propia con la que Subastin firma el token de sesion del widget (distinta de la anterior).
SESSION_SIGNING_KEY=
# Duracion de la sesion del widget, en horas. La anonima es provisional (D-018).
SESSION_TTL_HOURS=12
ANONYMOUS_SESSION_TTL_HOURS=24

# Limites del chat (RF-014). Provisionales hasta cerrar D-005.
MAX_MESSAGE_CHARS=2000
MESSAGES_PAGE_SIZE=50
# Origenes permitidos para el widget (CORS). dev: * · stage/prod: https://www.vmcsubastas.com
CORS_ALLOWED_ORIGINS=*
