# dev local (docker-compose). En stage/prod estas variables las inyecta CDK con los MISMOS
# nombres (infra/stacks/subastin_stack.py → common_env) y los secretos van en Secrets Manager.
STAGE=dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# Endpoints locales (vacios en AWS: boto3 resuelve solo)
DYNAMODB_ENDPOINT_URL=http://localhost:8001
SQS_ENDPOINT_URL=http://localhost:4566
S3_ENDPOINT_URL=http://localhost:4566

# Recursos
TABLE_CONVERSATIONS=subastin-dev-conversations
TABLE_MESSAGES=subastin-dev-messages
TABLE_TICKETS=subastin-dev-tickets
TABLE_ADVISORS=subastin-dev-advisors
TABLE_AI_USAGE=subastin-dev-ai-usage
IMAGES_BUCKET=subastin-dev-images
AI_JOBS_QUEUE_URL=http://localhost:4566/000000000000/subastin-dev-ai-jobs
NOTIFICATIONS_QUEUE_URL=http://localhost:4566/000000000000/subastin-dev-notifications

# IA — SOLO en dev van aqui; en stage/prod: Secrets Manager
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
