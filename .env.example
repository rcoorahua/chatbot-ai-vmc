# Plantilla de variables de entorno para dev local. Copiar a `.env` y completar.
# `.env` NO se versiona (esta en .gitignore). En stage/prod estas variables las inyecta CDK con
# los MISMOS nombres (infra/stacks/subastin_stack.py → common_env) y los secretos viven en
# Secrets Manager — nunca aqui ni en el codigo.

# Entorno: dev (local). stage/prod los define CDK.
STAGE=
# Region AWS (la confirma el equipo AWS, PLAN.md §6.1). Ej: us-east-1
AWS_REGION=
# En dev cualquier valor dummy sirve: dynamodb-local y localstack no validan credenciales.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Endpoints locales de docker-compose. Vacios en AWS (boto3 resuelve solo).
# dev: http://localhost:8001
DYNAMODB_ENDPOINT_URL=
# dev: http://localhost:4566
SQS_ENDPOINT_URL=
# dev: http://localhost:4566
S3_ENDPOINT_URL=

# Recursos (nombres con prefijo subastin-<stage>-, ver infra/stacks/subastin_stack.py)
TABLE_CONVERSATIONS=
TABLE_MESSAGES=
TABLE_TICKETS=
TABLE_ADVISORS=
TABLE_AI_USAGE=
TABLE_RATE_LIMITS=
IMAGES_BUCKET=
# dev: http://localhost:4566/000000000000/<nombre-cola>
AI_JOBS_QUEUE_URL=
NOTIFICATIONS_QUEUE_URL=

# IA — SOLO en dev van aqui; en stage/prod: Secrets Manager (TD-002 define acceso a Haiku)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# RAG en Pinecone (RF-017/018/019). El indice usa embedding integrado
# (multilingual-e5-large): Pinecone embebe el texto, NO se usa Gemini para eso.
# Lo crea `python -m scripts.helpcenter_upload` si no existe.
PINECONE_API_KEY=
PINECONE_INDEX_NAME=subastin-rag
PINECONE_NAMESPACE=helpcenter
# Fragmentos que recibe el redactor (mas de 5 encarece el prompt y mete ruido).
RAG_TOP_K=4
# Umbral de RF-018: por debajo se considera que no hay evidencia y el caso deriva.
# Calibrado 28/08/2026 (ver CLAUDE.md "RAG"): con 0.75 preguntas AJENAS a VMC pasaban el
# umbral. El margen real es angosto — re-verificar con `helpcenter_upload --verify` si el
# corpus crece mucho o si RB-009 falla en produccion.
RAG_MIN_SCORE=0.84
# Expansion por tema: con al menos un fragmento sobre el umbral, los del MISMO articulo que
# quedaron hasta esta distancia por debajo entran tambien (una errata baja todo ~0.01-0.02
# y dejaba fuera justo los pasos del registro). 0 la apaga. Ver CLAUDE.md "RAG".
RAG_SIBLING_MARGIN=0.04

# Identidad del chat (D-001, core/auth.py). SOLO en dev van aqui; en stage/prod: Secrets Manager.
# Secreto compartido con VMC: su servidor firma el JWT de identidad del usuario con el.
# dev: cualquier texto; debe coincidir con el que usa widget/test.html para simular a VMC.
VMC_IDENTITY_SECRET=
# Clave propia con la que Subastin firma el token de sesion del widget (distinta de la anterior).
SESSION_SIGNING_KEY=
# Duracion de la sesion del widget, en horas. La anonima es provisional (D-018).
SESSION_TTL_HOURS=12
ANONYMOUS_SESSION_TTL_HOURS=24

# Asesores en LOCAL (no hay Cognito): ADVISOR_DEV_AUTH=1 activa el middleware que imita al
# authorizer del API Gateway (backend/api/dev_auth.py). Token con `python -m scripts.advisor_token`.
# Se ignora dentro de una Lambda. En AWS el JWT lo valida el API Gateway y esto no existe.
ADVISOR_DEV_AUTH=
ADVISOR_DEV_JWT_SECRET=
# Mensajes que ve el asesor al abrir un hilo (los ultimos N; pagina hacia atras con `before`).
ADVISOR_THREAD_PAGE_SIZE=20
INBOX_PAGE_SIZE=50

# Pipeline IA (D-006 y D-020 cerradas 28/08). El debounce viaja como DelaySeconds de SQS:
# cada mensaje espera N segundos y responde solo el job del ultimo de la rafaga. 0 lo apaga.
AI_DEBOUNCE_SECONDS=6
# Mensaje identico repetido dentro de esta ventana: respuesta fija, sin llamada IA.
TRIVIAL_REPEAT_WINDOW_MINUTES=10
# Tope de salida del redactor (3-4 frases con margen).
AI_ANSWER_MAX_TOKENS=600

# Ventana de contexto de la IA (RF-013, D-004 cerrada 28/08). Los ultimos N mensajes de la
# ultima hora. NO hay resumen acumulado: pasada la ventana, el bot atiende solo el mensaje nuevo.
AI_CONTEXT_MESSAGES=20
AI_CONTEXT_WINDOW_MINUTES=60

# Limites del chat (RF-014, D-005 cerrada 28/08).
MAX_MESSAGE_CHARS=500
MESSAGES_PAGE_SIZE=50
# Rate limit por conversacion (= por usuario, D-002). Pasarse devuelve 429. 0 lo desactiva.
MAX_MESSAGES_PER_MINUTE=10
# Sin tope acumulativo de mensajes por conversacion: con D-003 no se cierra nunca, asi que un
# tope duro la dejaria inservible de por vida. El crecimiento lo rige la retencion (D-014).

# Tope de ejecuciones de IA por actor (T-09 / D-027 revisada 01/09). Cuenta mensajes que
# llamaron a un modelo (triviales/guardrails/reglas/botones no gastan). 0 o vacio = SIN tope,
# y asi queda en dev. Valores decididos para prod: anonimo 10/hora y 20/dia (por sesion Y por
# hash de IP, gana el que se agote primero); autenticado el doble (20/hora, 40/dia).
# Al agotarse el bot responde fijo: crear cuenta (anonimo) o pedir un asesor (autenticado).
AI_QUOTA_ANON_PER_HOUR=
AI_QUOTA_ANON_PER_DAY=
AI_QUOTA_AUTH_PER_HOUR=
AI_QUOTA_AUTH_PER_DAY=

# Casos y handoff con formulario (D-029). Casos abiertos a la vez por usuario autenticado;
# handoffs por dia que acepta una IP anonima (0 = sin tope, como en dev); dias que vive la
# conversacion anonima antes de que DynamoDB la borre (0 = sin TTL).
MAX_OPEN_CASES_PER_USER=5
ANON_HANDOFFS_PER_IP_PER_DAY=
ANON_SESSIONS_PER_IP_PER_DAY=
ANONYMOUS_CONVERSATION_TTL_DAYS=30
# Sal del HMAC para hashear la IP (dato personal, nunca en claro). Vacio = usa SESSION_SIGNING_KEY.
IP_HASH_SECRET=

# Imagenes (RF-040..042, valores de D-005; se aplican en F6). Todos los topes se renuevan
# (por imagen, por mensaje, por hora): ninguno es acumulativo.
MAX_IMAGE_BYTES=5242880
MAX_IMAGES_PER_MESSAGE=3
MAX_IMAGES_PER_HOUR=20
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
# Origenes permitidos para el widget (CORS). dev: * · stage/prod: https://www.vmcsubastas.com
CORS_ALLOWED_ORIGINS=*

# Observabilidad (RNF-006). Vacio = decidir por STAGE: dev/stage detallados (DEBUG, con vista
# previa del texto de los mensajes), prod sobrio (INFO, solo ids y metricas, sin contenido).
# LOG_FORMAT: text (terminal) | json (CloudWatch; es el default dentro de una Lambda).
LOG_LEVEL=
LOG_CONTENT=
LOG_FORMAT=
# Rutas /dev/* (consola de widget/test.html: que decidio el bot, tokens, costo, latencia).
# Encendido salvo en prod; solo muestra metricas de la conversacion de la sesion.
DEV_OBSERVABILITY=
